{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's windows may do: move, size, show, hide and close their own windows, open the overlay's widget windows and the big map, let clicks through, read which screen they are on, and open raidkits.com and Discord links in the browser. Nothing else.",
  "windows": [
    "overlay",
    "panel",
    "bigmap",
    "w-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-resizable",
    "core:window:allow-start-resize-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://raidkits.com/*"
        },
        {
          "url": "https://discord.gg/*"
        },
        {
          "url": "https://discord.com/*"
        }
      ]
    },
    "core:window:allow-minimize"
  ]
}
